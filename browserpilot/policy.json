{
  "_comment": "Single source of truth for the default network policy. Read by browserpilot/config.py, scripts/mcp_smoke_test.mjs and the config-drift test.",
  "playwright_mcp_version": "0.0.68",
  "blocked_origins": [
    "http://localhost:*",
    "https://localhost:*",
    "http://127.0.0.1:*",
    "https://127.0.0.1:*",
    "http://[::1]:*",
    "https://[::1]:*",
    "http://0.0.0.0:*",
    "http://169.254.169.254",
    "http://metadata.google.internal"
  ],
  "blocked_host_suffixes": [".local", ".internal", ".localhost"],
  "blocked_hosts": ["localhost", "metadata.google.internal"],
  "allowed_url_schemes": ["http", "https"]
}
